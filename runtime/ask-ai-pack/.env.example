ASK_AI_API_KEY=replace-with-strong-random-key
ASK_AI_PROVIDER=openai
ASK_AI_MODEL=gpt-4.1-mini
ASK_AI_BASE_URL=https://api.openai.com/v1
ASK_AI_PROVIDER_API_KEY=replace-with-provider-key
# strict-local example (Ollama, no key needed):
# ASK_AI_PROVIDER=local
# ASK_AI_MODEL=qwen2.5:7b
# ASK_AI_BASE_URL=http://localhost:11434/v1
# Optional shared provider key fallback (recommended for centralized entitlement model)
DOCSOPS_SHARED_OPENAI_API_KEY=
ASK_AI_REQUIRE_AUTH=true
ASK_AI_BILLING_MODE=user-subscription
ASK_AI_WEBHOOK_SECRET=replace-with-webhook-secret
ASK_AI_MAX_CONTEXT_MODULES=6
ASK_AI_MAX_TOKENS=700
ASK_AI_TEMPERATURE=0.2
ASK_AI_RATE_LIMIT_PER_USER_PER_MINUTE=20
ASK_AI_KNOWLEDGE_INDEX_PATH=docs/assets/knowledge-retrieval-index.json
ASK_AI_ASSISTANT_BUNDLE_GLOB=reports/intent-bundles/*-assistant.json
# Retrieval intelligence
ASK_AI_RETRIEVAL_MODE=auto
ASK_AI_VECTORLESS_MIN_SCORE=2.0
ASK_AI_GRAPH_RERANK_ENABLED=true
ASK_AI_GRAPH_RERANK_BOOST=0.35
ASK_AI_QUERY_DECOMP_ENABLED=true
ASK_AI_ENTITY_FIRST_ENABLED=true
# Conversation and analytics
ASK_AI_HISTORY_MAX_TURNS=6
ASK_AI_USAGE_LOG_ENABLED=true
ASK_AI_USAGE_LOG_PATH=reports/ask_ai_usage.jsonl
# Confidence guardrail and contradiction warnings
ASK_AI_MIN_CONFIDENCE=0.28
ASK_AI_CONTRADICTIONS_REPORT_PATH=reports/rag_contradictions_report.json
ASK_AI_OWNER_ALERT_LOG_PATH=reports/ask_ai_owner_alerts.jsonl
# Endpoint security (widget cross-origin, host allow-list, optional HTTPS redirect)
ASK_AI_CORS_ORIGINS=http://localhost:3000
ASK_AI_TRUSTED_HOSTS=*
ASK_AI_HTTPS_REDIRECT=false
