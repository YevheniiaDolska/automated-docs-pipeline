pipeline {
  agent any
  options { timestamps() }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Install') {
      steps {
        sh 'npm ci || true'
        sh 'python3 -m pip install --upgrade pip'
        sh 'python3 -m pip install -r requirements-dev.txt || true'
        sh 'python3 -m pip install mkdocs sphinx || true'
      }
    }
    stage('Docs Lint + Build') {
      environment {
        DOCSOPS_SITE_GENERATOR = 'mkdocs'
        DOCSOPS_SITE_BUILD_COMMAND = 'mkdocs build --strict'
        DOCSOPS_DOCS_LINT_COMMAND = 'npm run lint'
      }
      steps {
        sh 'python3 docsops/scripts/run_docs_ci_checks.py --runtime-config docsops/config/client_runtime.yml'
      }
    }
  }
}
